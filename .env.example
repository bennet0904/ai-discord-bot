# --- Discord -----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# There is no LLM configuration here on purpose. Every server owner connects
# their own model and API key with /ai llm. LLM keys set in this environment
# (OPENAI_API_KEY and so on) are removed at startup so they can never be used.

# --- Security ----------------------------------------------------------------
# Key used to encrypt the API keys servers save. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is generated and stored in DATA_DIR/secret.key. Back it up:
# without it all saved API keys are lost.
ENCRYPTION_KEY=
# Allow servers to point their LLM at private or local addresses
# (localhost, 10.x, 192.168.x, ...). Only enable this if you run the bot for
# yourself, e.g. to use a local Ollama. Otherwise anyone could reach your
# internal network through the bot.
ALLOW_PRIVATE_API_BASE=false

# --- Behaviour ---------------------------------------------------------------
CONSOLE_CHANNEL_NAME=ai-console
# Ask for Approve/Deny before destructive actions (delete, kick, ban, writing tools)
REQUIRE_CONFIRMATION=true
# Post a small line for every tool call in the console
SHOW_TOOL_CALLS=true
# Max LLM round trips per message
MAX_TOOL_ROUNDS=20
# Messages of conversation history kept per server
MAX_HISTORY_MESSAGES=60
LLM_TIMEOUT_SECONDS=180
# Retries when the LLM provider is overloaded (503), rate limited or unreachable.
# Waits 3s, 6s, 12s, 24s ... between attempts.
LLM_RETRIES=4
# Extra text appended to the system prompt on every server
SYSTEM_PROMPT_EXTRA=

# --- Custom tools (self-programming) ------------------------------------------
# Every server can let the assistant write its own tools. They run in a
# sandboxed process (Linux or macOS only).
ENABLE_CUSTOM_TOOLS=true
MAX_CUSTOM_TOOLS=50
MAX_CUSTOM_TOOL_CODE_CHARS=20000
SANDBOX_CPU_SECONDS=10
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT_SECONDS=600
SANDBOX_MAX_CALLS=100
SANDBOX_MAX_PARALLEL=4

DATA_DIR=data
LOG_LEVEL=INFO
