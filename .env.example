# --- Discord -----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# --- LLM ---------------------------------------------------------------------
# Any LiteLLM model string: "<provider>/<model>". Examples:
#   anthropic/claude-sonnet-5-5
#   openai/gpt-4o
#   gemini/gemini-2.5-pro
#   mistral/mistral-large-latest
#   groq/llama-3.3-70b-versatile
#   deepseek/deepseek-chat
#   xai/grok-3
#   openrouter/<vendor>/<model>
#   ollama_chat/llama3.1            (local, set LLM_API_BASE=http://localhost:11434)
#   openai/<name>                   (any OpenAI-compatible server, set LLM_API_BASE)
# Full list: https://docs.litellm.ai/docs/providers
# The model must support tool / function calling.
LLM_MODEL=anthropic/claude-sonnet-5-5

# Provider keys. Set the one(s) for the provider you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides, mostly for self-hosted or OpenAI-compatible endpoints
# (LM Studio, vLLM, LocalAI, Azure proxies, ...).
LLM_API_KEY=
LLM_API_BASE=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=

# --- Behaviour ---------------------------------------------------------------
# Name of the private channel created on every server
CONSOLE_CHANNEL_NAME=ai-console
# Ask for Approve/Deny before destructive actions (delete, kick, ban, writing code)
REQUIRE_CONFIRMATION=true
# Let the assistant write its own Python tools (only usable by the bot owner)
ENABLE_CUSTOM_TOOLS=true
# Post a small line for every tool call in the console
SHOW_TOOL_CALLS=true
# Max LLM round trips per message
MAX_TOOL_ROUNDS=20
# How many messages of conversation history to keep per server
MAX_HISTORY_MESSAGES=60
# Comma separated Discord user ids that count as bot owner. Empty = the owner
# (or team members) of the Discord application.
BOT_OWNER_IDS=
# Extra text appended to the system prompt
SYSTEM_PROMPT_EXTRA=

DATA_DIR=data
PLUGINS_DIR=plugins
LOG_LEVEL=INFO
